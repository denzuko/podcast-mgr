# podcast-mgr.socket — systemd USER unit for fcgiwrap socket
#
# Install: ~/.config/systemd/user/podcast-mgr.socket
# Enable:  systemctl --user enable --now podcast-mgr.socket
#
# Socket lives at /run/fcgi/podcast-mgr.sock — a shared dir created by
# tmpfiles.d (see examples/podcast-mgr-tmpfiles.conf) with ownership
# <USER>:www-data so haproxy (group www-data) can reach it from inside
# its chroot without bind-mounts or XDG_RUNTIME_DIR path games.
#
# One-time root setup before enabling this unit:
#   sudo cp examples/podcast-mgr-tmpfiles.conf /etc/tmpfiles.d/podcast-mgr.conf
#   sudo systemd-tmpfiles --create /etc/tmpfiles.d/podcast-mgr.conf

[Unit]
Description=podcast-mgr fcgiwrap FastCGI socket

[Socket]
ListenStream=/run/fcgi/podcast-mgr.sock
SocketMode=0660
SocketUser=<USER>
SocketGroup=www-data

[Install]
WantedBy=sockets.target
