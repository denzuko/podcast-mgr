# podcast-mgr.service — systemd USER unit for index.cgi FastCGI worker
#
# Install: ~/.config/systemd/user/podcast-mgr.service
# Enable:  systemctl --user enable --now podcast-mgr.socket
#
# index.cgi is a persistent FastCGI worker built with kcgi's khttp_fcgi_*
# API. It calls khttp_fcgi_init() which picks up the socket passed by
# systemd via LISTEN_FDS, then loops in khttp_fcgi_parse() handling
# requests. It must run directly — NOT via fcgiwrap.
#
# fcgiwrap exec()s a new process per request (CGI model). index.cgi
# expects to be long-lived (FastCGI model). Running index.cgi under
# fcgiwrap causes a deadlock: fcgiwrap speaks FastCGI to haproxy while
# index.cgi tries to initialise its own FastCGI listener on the same fd.
#
# %h = $HOME

[Unit]
Description=podcast-mgr FastCGI worker
Requires=podcast-mgr.socket
After=podcast-mgr.socket

[Service]
Type=simple

# index.cgi uses khttp_fcgi_init() which checks FCGI_LISTENSOCK_FILENO (fd 0)
# for an inherited socket. StandardInput=socket tells systemd to pass the
# socket unit's fd as stdin so kcgi finds it on fd 0 as the FastCGI spec
# requires. Without this, systemd passes via LISTEN_FDS (fd 3+) and
# khttp_fcgi_init falls back to standalone mode, hanging on accept().
StandardInput=socket
StandardOutput=socket
StandardError=journal

# Point at your built index.cgi — adjust <BUILDDIR> to match:
#   Dev:  %h/podcast-mgr/index.cgi   (./nob install default)
#   Prod: /usr/local/libexec/podcast-mgr/index.cgi
ExecStart=%h/podcast-mgr/index.cgi

# HOME lets resolve_config_path() find ~/.config/podcasts/feeds.xml
Environment=HOME=%h
# Environment=XDG_CONFIG_HOME=%h/.config

Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
