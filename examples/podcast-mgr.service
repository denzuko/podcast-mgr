# podcast-mgr.service — systemd USER unit for index.cgi via fcgiwrap
#
# index.cgi is a plain CGI binary (khttp_parse). fcgiwrap speaks FastCGI
# to haproxy and exec()s index.cgi per request as a CGI process.
#
# %h = $HOME

[Unit]
Description=podcast-mgr CGI worker (via fcgiwrap)
Requires=podcast-mgr.socket
After=podcast-mgr.socket

[Service]
Type=simple
StandardInput=socket
StandardOutput=socket
StandardError=journal

ExecStart=/usr/sbin/fcgiwrap -c 4 -p <BUILDDIR>/index.cgi

Environment=HOME=%h

Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
