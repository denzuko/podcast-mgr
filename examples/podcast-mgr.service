# podcast-mgr.service — systemd USER unit for fcgiwrap worker
#
# Install: ~/.config/systemd/user/podcast-mgr.service
# Enable:  systemctl --user enable --now podcast-mgr.socket
#          (enabling the socket is sufficient; service activates on demand)
#
# %h  = $HOME (/home/nuci3)
#
# index.cgi calls getenv("HOME") via resolve_config_path() to locate
# ~/.config/podcasts/feeds.xml. The Environment= line ensures HOME is
# set correctly when the unit starts without a login session
# (i.e. after loginctl enable-linger).

[Unit]
Description=podcast-mgr FastCGI worker
Requires=podcast-mgr.socket
After=podcast-mgr.socket

[Service]
Type=simple

# Adjust path to index.cgi to match your build/install location:
#   Dev:  %h/podcast-mgr/index.cgi
#   Prod: /usr/local/libexec/podcast-mgr/index.cgi
ExecStart=/usr/bin/fcgiwrap -c 1 -f -s unix:/run/fcgi/podcast-mgr.sock

Environment=HOME=%h
# Environment=XDG_CONFIG_HOME=%h/.config

Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
