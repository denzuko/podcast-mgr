  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "podcast-mgr security scan",
          "version": "1.0.0",
          "informationUri": "https://sarifweb.azurewebsites.net/",
          "rules": [
            {
              "id": "cppcheck/constVariablePointer",
              "name": "ConstVariablePointer",
              "shortDescription": {
                "text": "Variable can be declared as pointer to const"
              },
              "fullDescription": {
                "text": "The pointer variable does not modify the pointed-to value and can be declared const. CWE-398: Indicator of Poor Code Quality."
              },
              "helpUri": "https://cppcheck.sourceforge.io/",
              "properties": {
                "tags": [
                  "correctness",
                  "style"
                ],
                "precision": "high",
                "problem.severity": "recommendation",
                "security-severity": "2.0"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ],
          "properties": {
            "cdxgen": "CycloneDX 1.6 SBOM",
            "sbomSerial": "urn:uuid:46f38308-b3f7-4db3-aa27-83256129142b",
            "cppcheck": "2.13.0",
            "osvScanner": "api.osv.dev/v1"
          }
        },
