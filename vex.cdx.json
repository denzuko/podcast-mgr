      ],
      "description": "glibc iconv() output buffer overflow in versions <= 2.39",
      "affects": [
        {
          "ref": "pkg:deb/libc6-dev@2.39-0ubuntu8.7#/var/lib/dpkg"
        }
      ],
      "analysis": {
        "state": "not_affected",
